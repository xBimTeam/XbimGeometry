<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
		<Title>Xbim Tessellator</Title>
		<IsPackable>true</IsPackable>
		<Description>Provides support for tessellating mesh geometries.</Description>
		<LangVersion>latest</LangVersion>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\xbim-toolkit-icon.png" Pack="True" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xbim.Essentials" Version="6.0.540-develop" />
	</ItemGroup>
</Project>
